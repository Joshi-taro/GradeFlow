{
  "name": "gradeflow",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@12.2.1",
  "engines": { "node": "^24.15.0" },
  "scripts": {
    "lint": "eslint core.js script.js config.js tests scripts/*.mjs && html-validate index.html",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run lint && npm test",
    "serve": "node scripts/serve.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "html-validate": "11.17.0",
    "jsdom": "30.1.3"
  }
}
